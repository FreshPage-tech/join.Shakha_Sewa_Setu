{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/join",
      "destination": "/"
    },
    {
      "source": "/join/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/register-leader-bee",
      "destination": "/register-leader-bee.html"
    },
    {
      "source": "/admin-join-app",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|_next/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
